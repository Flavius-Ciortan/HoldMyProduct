{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": { "php": "7.4", "wp": "latest" },
  "steps": [
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" }, "options": { "activate": true } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "plugin-check" }, "options": { "activate": true } },
    { "step": "activatePlugin", "pluginPath": "/wordpress/wp-content/plugins/hold-this-product/hold-this-product.php" },
    { "step": "wp-cli", "command": "wp plugin check hold-this-product --format=json" }
  ]
}
